# --- Middleware (packages/server) ---

# Basis-URL des OpenAI-kompatiblen LLM-Endpunkts (z. B. LiteLLM-Proxy), z. B. https://litellm.example.com
LITELLM_BASE_URL=http://localhost:4000

# API-Key des LLM-Endpunkts (bei LiteLLM: Virtual Key oder Master Key). Bleibt NUR serverseitig.
LITELLM_API_KEY=sk-...

# Modell, das verwendet wird, wenn der Client keins wählt
DEFAULT_MODEL=claude-sonnet-5

# Optional: kommaseparierte Allowlist der Modelle, die Clients wählen dürfen.
# Leer = alle Modelle, die der Endpunkt unter /v1/models meldet. Ein in der
# Admin-UI gespeicherter Modell-Katalog (IDs + Anzeigenamen) übersteuert
# diese Liste.
MODEL_ALLOWLIST=

# Port der Middleware
PORT=3000

# Optional: kommaseparierte erlaubte Origins für CORS.
# Nur nötig, wenn Extension und Middleware getrennt gehostet werden.
# In Dev (Vite-Proxy) und Prod (Same-Origin-Serving) leer lassen.
ALLOWED_ORIGINS=

# Optional (prod): Verzeichnis mit dem gebauten Extension-Frontend,
# das die Middleware als Statik ausliefert (Same-Origin, kein CORS nötig).
SERVE_STATIC_DIR=

# Optional: Shared Token für /api/* (Schutz gegen Missbrauch als offener
# LLM-Proxy). Wenn gesetzt, muss die Extension denselben Token in den
# Einstellungen hinterlegen. Ohne Token: Zugriff auf Netzwerkebene beschränken!
API_AUTH_TOKEN=

# Optional: statisches Bearer-Token für die Admin-UI unter /admin (zentrale
# Slash-Befehle, Manifest-Download, anonyme Nutzungsstatistik) — eigenes,
# von API_AUTH_TOKEN unabhängiges Regime. OHNE Token, aber MIT aktivem
# User-Memory, läuft die Admin-UI im Passwort-Modus: Beim ersten Zugriff
# legt der Anwender das Admin-Passwort selbst an (Ersteinrichtung wie in
# PaddleDoc), danach Login mit Passwort + Session. Ohne Token UND ohne
# Memory: /admin liefert 404. Die Admin-UI hat kein eigenes Netzwerk-
# Schutzkonzept — nur intern erreichbar machen (Ingress/NetworkPolicy)!
ADMIN_TOKEN=

# --- Datenbank (Memory-Store) ---
# Trägt Admin-Konto, Anmeldung, Slash-Befehle, Playbooks, Statistik — und, mit
# Enterprise-Lizenz, das User-Memory und die gespeicherten eigenen Abfragen.
# Postgres-URI (Prod/EKS; kommt im Helm-Deployment aus dem CloudNativePG-Secret).
MEMORY_DATABASE_URL=
# SQLite-Fallback für lokale Entwicklung (ignoriert, wenn MEMORY_DATABASE_URL gesetzt).
MEMORY_DB_PATH=./data/memory.db
# Günstiges Modell für die Fakten-Extraktion (leer = DEFAULT_MODEL); nur mit
# Enterprise-Lizenz-Feature "memory" aktiv.
MEMORY_MODEL=

# --- Themen-Scope-Guard ---
# Serverseitiger Filter VOR dem Haupt-LLM-Call: Fragen ohne Dashboard-Bezug
# werden abgelehnt, ohne das Hauptmodell aufzurufen. on (Default) | off.
SCOPE_GUARD=on
# Günstiges Modell für die Klassifikation (leer = MEMORY_MODEL bzw. DEFAULT_MODEL).
SCOPE_MODEL=

# Log-Level: debug | info | warn | error
LOG_LEVEL=info

# --- Enterprise Edition (ee/): Anmeldung & Lizenz ---
# Zugriffsschutz für /api/*: none | token | local | oidc. Default: token,
# sobald API_AUTH_TOKEN gesetzt ist, sonst none. local = Benutzerkonten aus
# der Admin-UI (Open Core), oidc = Single Sign-On der Anwender (Microsoft
# Entra ID / Keycloak) — braucht eine gültige Enterprise-Lizenz mit Feature
# "sso". Alles hier sind Env-Defaults; die Admin-UI (Abschnitt „Anmeldung,
# Single Sign-On & Lizenz“) kann Modus, OIDC und Lizenz zur Laufzeit setzen
# (siehe docs/enterprise.md).
AUTH_MODE=
# Öffentlicher Origin der Middleware (https://chat.example.com) — Pflicht für
# Single Sign-On: daraus entsteht die Redirect-URI <PUBLIC_URL>/auth/callback
# (nie aus dem Host-Header). Alternativ in der Admin-UI eintragen.
PUBLIC_URL=
# entra | keycloak | generic
OIDC_PROVIDER=generic
# Entra: https://login.microsoftonline.com/<tenant-id>/v2.0
# Keycloak: https://<host>/realms/<realm>
OIDC_ISSUER=
OIDC_CLIENT_ID=
# Nur für confidential clients; public clients (PKCE) lassen es leer.
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid profile email
# Signierter Lizenzschlüssel (Token) oder Pfad zur Lizenzdatei …
OVP_LICENSE=
OVP_LICENSE_PATH=
# … und der Ed25519-Public-Key des Lizenzgenerators (32 Bytes base64url oder PEM-Pfad).
OVP_LICENSE_PUBLIC_KEY_B64URL=
OVP_LICENSE_PUBLIC_KEY_PATH=
