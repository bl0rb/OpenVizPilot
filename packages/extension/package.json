{
  "name": "@openvizpilot/extension",
  "private": true,
  "version": "0.1.0",
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "dev:static-demo": "VITE_MOCK=1 vite --mode demo",
    "build": "vite build",
    "build:static-demo": "vite build --mode demo --outDir dist-demo && tsx scripts/make-trex.ts --demo --url ${OVP_DEMO_URL:-https://demo.werkworks.de/} --out dist-demo/openvizpilot-demo.trex",
    "build:trex": "tsx scripts/make-trex.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@openvizpilot/ee": "0.1.0",
    "@openvizpilot/shared": "*",
    "dompurify": "^3.4.17",
    "marked": "^18.1.1",
    "preact": "^11.0.1"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.9.0",
    "@tableau/extensions-api-types": "^1.12.0",
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "vite": "^8.3.5"
  }
}
