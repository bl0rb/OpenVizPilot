# Konfiguration für compose.yaml — kopieren nach .env und ausfüllen.
# Alle OVP_*-Variablen aus der Datei .env.example im Repo-Root können hier
# zusätzlich gesetzt werden (OIDC, Lizenz, SMTP, Scope-Guard …).

# --- Image ---
# Release-Version ohne "v", z. B. 1.6.1
DEPLOY_VERSION=
# Enterprise: ghcr.io/bl0rb/openvizpilot-enterprise (vorher docker login ghcr.io)
DEPLOY_IMAGE=ghcr.io/bl0rb/openvizpilot

# --- Netzwerk ---
# Hostname, unter dem die Browser der Tableau-Nutzer die Middleware erreichen
# (ohne https://). Pflicht mit Profil "caddy".
DEPLOY_HOST=chat.example.com
# Öffentlicher Origin — Pflicht für Single Sign-On und die Manifest-URL.
OVP_PUBLIC_URL=https://chat.example.com
# Nur ohne Caddy relevant: Adresse/Port, auf denen die Middleware für den
# eigenen Reverse Proxy lauscht (Default 127.0.0.1:3000).
# DEPLOY_BIND=127.0.0.1
# DEPLOY_PORT=3000
# Caddy immer mitstarten, ohne --profile caddy:
# COMPOSE_PROFILES=caddy

# --- Datenbank ---
# Nur Buchstaben und Ziffern (steht in der Verbindungs-URI), z. B. openssl rand -hex 24
POSTGRES_PASSWORD=

# --- LLM ---
OVP_LLM_BASE_URL=https://litellm.example.com
OVP_LLM_API_KEY=
OVP_DEFAULT_MODEL=
OVP_MODEL_ALLOWLIST=

# --- Sicherheit ---
# Verschlüsselt die in der Admin-UI gespeicherten Tableau-Secrets, z. B. openssl rand -hex 32
OVP_SECRET_KEY=
# none | token | local | oidc (siehe docs/enterprise.md)
OVP_AUTH_MODE=local
# production | development | test | staging
OVP_ENVIRONMENT=production
